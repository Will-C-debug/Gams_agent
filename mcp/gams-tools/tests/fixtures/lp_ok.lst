   5  Set g 'units' / g1*g3 /;
   6  Parameter cap(g) 'capacity MW' / g1 100, g2 80, g3 50 /;
   7  Parameter cost(g) 'cost $/MWh' / g1 20, g2 30, g3 50 /;
   8  Parameter load(t) / t1 120, t2 150, t3 200, t4 90 /;
