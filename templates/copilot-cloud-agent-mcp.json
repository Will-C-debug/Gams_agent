{
  "mcpServers": {
    "gams-tools": {
      "type": "local",
      "command": "gams-tools",
      "args": ["mcp"],
      "tools": ["*"]
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "headers": {
        "Authorization": "Basic $COPILOT_MCP_ATLASSIAN_BASIC_AUTH"
      },
      "tools": [
        "getAccessibleAtlassianResources",
        "getJiraIssue",
        "getJiraIssueRemoteIssueLinks",
        "searchJiraIssuesUsingJql",
        "getConfluencePage",
        "searchConfluenceUsingCql"
      ]
    }
  }
}
